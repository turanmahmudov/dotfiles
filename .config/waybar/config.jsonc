// -*- mode: jsonc -*-
{
    "include": [
        "~/.config/waybar/modules/main.jsonc",
        "~/.config/waybar/modules/hyprland.jsonc",
        "~/.config/waybar/modules/group.jsonc",
        "~/.config/waybar/modules/custom.jsonc"
    ],
    "height": 35,
    "spacing": 7,
    "margin": "0 10px",
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "privacy",
        "custom/updates",
        "tray",
        "mpris",
        "idle_inhibitor",
        // "custom/clipboard",
        "hyprland/language",
        "group/hardware",
        // "backlight",
        // "wireplumber#mic",
        // "wireplumber#speaker",
        // "network",
        // "network#vpn",
        // "bluetooth",
        "group/audio",
        "group/connectivity",
        "group/power",
        "custom/notification",
        "custom/power"
    ]
}
