#!/bin/sh
echo "Installing Personal Dependencies"

sudo apt-get update -qq

# Deb packages
sudo apt-get install -y \
    build-essential \
    zsh \
    git \
    curl \
    pipx \
    btop \
    fastfetch \
    tmux \
    docker.io \
    syncthing

# Snap packages
sudo snap install nvim --classic
sudo snap install obsidian --classic
sudo snap install spotify
sudo snap install bitwarden

# Binary packages
if ! command -v getnf >/dev/null 2>&1; then
    curl -fsSL https://raw.githubusercontent.com/ronniedroid/getnf/master/install.sh | bash
fi
if ! command -v mise &> /dev/null; then
    curl https://mise.run | sh
fi

# Mise
mise use --global node@24
mise use --global ruby@4
mise use --global go@1.25
mise use --global opencode
mise use --global lazygit
mise use --global lazydocker
mise use --global fzf
mise use --global ripgrep
mise reshim
