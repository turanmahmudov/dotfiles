#!/bin/sh
echo "Installing Work Dependencies"

# PPAs
if ! grep -q "cppiber/hyprland/ubuntu" /etc/apt/sources.list /etc/apt/sources.list.d/* 2>/dev/null; then
    sudo add-apt-repository -y ppa:cppiber/hyprland
fi

# if ! grep -q "ondrej/php/ubuntu" /etc/apt/sources.list /etc/apt/sources.list.d/* 2>/dev/null; then
#     sudo add-apt-repository -y ppa:ondrej/php
#     sudo sed -i 's/questing/noble/g' /etc/apt/sources.list.d/ondrej-ubuntu-php-*.sources
# fi

sudo apt-get update -qq

# Deb packages
sudo apt-get install -y \
    build-essential \
    zsh \
    git \
    curl \
    pipx \
    kitty \
    foot \
    btop \
    fastfetch \
    tmux \
    waybar \
    hyprland hyprpaper hypridle hyprlock hyprpolkitagent \
    hyprland-qt-support0 \
    xdg-desktop-portal-hyprland \
    pipewire wireplumber \
    sway-notification-center \
    swayosd \
    brightnessctl \
    playerctl \
    fzf ripgrep \
    tree \
    docker.io docker-buildx docker-compose \
    slurp grim \
    wl-clipboard cliphist \
    lazygit \
    syncthing \
    openconnect \
    php8.5 php8.5-bcmath php8.5-cli php8.5-common php8.5-curl php8.5-fpm php8.5-intl php8.5-mbstring php8.5-pgsql php8.5-readline php8.5-xdebug php8.5-xml php8.5-zip

# Snap packages
sudo snap install nvim --classic
sudo snap install code --classic
sudo snap install obsidian --classic
sudo snap install spotify
sudo snap install slack
sudo snap install bitwarden
sudo snap install bw
sudo snap install aws-cli --classic
sudo snap install terraform --classic
sudo snap install zig --beta --classic

# Binary packages
if ! command -v lazydocker >/dev/null 2>&1; then
    curl https://raw.githubusercontent.com/jesseduffield/lazydocker/master/scripts/install_update_linux.sh | bash
fi
if ! command -v getnf >/dev/null 2>&1; then
    curl -fsSL https://raw.githubusercontent.com/ronniedroid/getnf/master/install.sh | bash
fi
if ! command -v vicinae > /dev/null 2>&1; then
    curl -fsSL https://vicinae.com/install.sh | bash
fi
if ! command -v mise > /dev/null 2>&1; then
    curl https://mise.run | sh
fi
if ! command -v claude > /dev/null 2>&1; then
    curl -fsSL https://claude.ai/install.sh | bash
fi
mise use --global node@24
mise use --global ruby@4
mise use --global go@1.25
mise use --global npm:opencode-ai
mise use --global npm:tree-sitter-cli
mise reshim

# Composer
if ! command -v composer > /dev/null 2>&1; then
    php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');"
    php composer-setup.php
    php -r "unlink('composer-setup.php');"
    sudo mv composer.phar /usr/local/bin/composer
fi
