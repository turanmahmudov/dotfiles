#!/bin/sh
echo "Installing Work Dependencies"

# Hyprland PPA
if ! grep -q "cppiber/hyprland/ubuntu" /etc/apt/sources.list /etc/apt/sources.list.d/* 2>/dev/null; then
    sudo add-apt-repository -y ppa:cppiber/hyprland
fi

# Firefox PPA
if ! grep -q "mozillateam/ppa/ubuntu" /etc/apt/sources.list /etc/apt/sources.list.d/* 2>/dev/null; then
    sudo add-apt-repository -y ppa:mozillateam/ppa
fi

# Prefer firefox deb over snap
sudo tee /etc/apt/preferences.d/mozilla-firefox >/dev/null <<'EOF'
Package: firefox*
Pin: release o=LP-PPA-mozillateam
Pin-Priority: 1001
EOF

# Keep firefox auto-updating from the PPA
echo 'Unattended-Upgrade::Allowed-Origins:: "LP-PPA-mozillateam:${distro_codename}";' \
    | sudo tee /etc/apt/apt.conf.d/51unattended-upgrades-firefox >/dev/null

# Drop firefox snap
if snap list firefox >/dev/null 2>&1; then
    sudo snap remove --purge firefox
fi

# Quickshell PPA
if ! grep -q "avengemedia/danklinux/ubuntu" /etc/apt/sources.list /etc/apt/sources.list.d/* 2>/dev/null; then
    sudo add-apt-repository -y ppa:avengemedia/danklinux
fi

sudo apt-get update -qq

# Deb packages
sudo apt-get install -y \
    build-essential \
    intel-media-va-driver-non-free vainfo
    zsh \
    git \
    curl \
    pipx \
    kitty \
    foot \
    btop \
    fastfetch \
    tmux \
    quickshell \
    hyprland hypridle hyprlock hyprsunset \
    hyprland-qt-support0 \
    xdg-desktop-portal-hyprland \
    pipewire wireplumber \
    network-manager bluez \
    brightnessctl \
    ddcutil \
    playerctl \
    jq \
    tree \
    docker.io docker-buildx docker-compose \
    slurp grim wf-recorder \
    wl-clipboard cliphist \
    syncthing \
    openconnect \
    firefox

# Slack
if ! command -v slack >/dev/null 2>&1; then
    slack_ver=$(curl -fsSL https://slack.com/downloads/instructions/linux \
        | sed -nE 's#.*desktop-releases/linux/x64/([0-9.]+)/.*#\1#p' | head -1)
    slack_deb=$(mktemp --suffix=.deb)
    curl -fsSL -o "$slack_deb" \
        "https://downloads.slack-edge.com/desktop-releases/linux/x64/${slack_ver}/slack-desktop-${slack_ver}-amd64.deb"
    chmod 644 "$slack_deb" # mktemp gives 0600; the _apt user must be able to read it
    sudo apt-get install -y "$slack_deb"
    rm -f "$slack_deb"
fi

# Obsidian
if ! command -v obsidian >/dev/null 2>&1; then
    obsidian_tag=$(curl -fsSLI -o /dev/null -w '%{url_effective}' \
        https://github.com/obsidianmd/obsidian-releases/releases/latest \
        | sed -nE 's#.*/tag/v?([0-9.]+)$#\1#p')
    obsidian_deb=$(mktemp --suffix=.deb)
    curl -fsSL -o "$obsidian_deb" \
        "https://github.com/obsidianmd/obsidian-releases/releases/download/v${obsidian_tag}/obsidian_${obsidian_tag}_amd64.deb"
    chmod 644 "$obsidian_deb"
    sudo apt-get install -y "$obsidian_deb"
    rm -f "$obsidian_deb"
fi

# GitHub Desktop
if ! command -v github-desktop >/dev/null 2>&1; then
    ghd_ver=$(curl -fsSLI -o /dev/null -w '%{url_effective}' \
        https://github.com/shiftkey/desktop/releases/latest \
        | sed -nE 's#.*/tag/release-(.+)$#\1#p')
    ghd_deb=$(mktemp --suffix=.deb)
    curl -fsSL -o "$ghd_deb" \
        "https://github.com/shiftkey/desktop/releases/download/release-${ghd_ver}/GitHubDesktop-linux-amd64-${ghd_ver}.deb"
    chmod 644 "$ghd_deb"
    sudo apt-get install -y "$ghd_deb"
    rm -f "$ghd_deb"
fi

# Snap packages
sudo snap install nvim --classic
sudo snap install code --classic
sudo snap install spotify
sudo snap install bitwarden
sudo snap install bw

# Binary packages
if ! command -v getnf >/dev/null 2>&1; then
    curl -fsSL https://raw.githubusercontent.com/ronniedroid/getnf/master/install.sh | bash
fi
if ! command -v vicinae > /dev/null 2>&1; then
    curl -fsSL https://vicinae.com/install.sh | bash
fi
if ! command -v mise > /dev/null 2>&1; then
    curl https://mise.run | sh
fi

# Mise
mise use --global node@24
mise use --global bun
mise settings ruby.compile = false
mise use --global ruby@4
mise use --global go@1.25
mise plugin install php https://github.com/verzly/mise-php#latest
mise config set env._.php.prebuilt_static true
mise config set env._.php.prebuilt_static_flavor bulk
mise use --global php@8.5
mise use --global claude
mise use --global opencode
mise use --global tree-sitter
mise use --global lazygit
mise use --global lazydocker
mise use --global github:agavra/tuicr
mise use --global terraform
mise use --global awscli
mise use --global zig
mise use --global fzf
mise use --global ripgrep
mise use --global "github:cli/cli[exe=gh]"
mise reshim

