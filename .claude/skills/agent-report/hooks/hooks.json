{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "~/.local/bin/agent report claude working learn" }] }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "~/.local/bin/agent report claude blocked" }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "~/.local/bin/agent report claude working" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "~/.local/bin/agent report claude done" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "~/.local/bin/agent report claude gone" }] }
    ]
  }
}
