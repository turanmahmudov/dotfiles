#!/bin/sh

set -e

if [ $# -lt 1 ] || { [ "$1" != "dark" ] && [ "$1" != "light" ]; }; then
    echo "Usage: $0 <dark|light>" >&2
    exit 1
fi

mode="$1"
gtk3_config_dir="$HOME/.config/gtk-3.0"
gtk4_config_dir="$HOME/.config/gtk-4.0"

mkdir -p "$gtk3_config_dir" "$gtk4_config_dir"

if [ "$mode" = "light" ]; then
    gtk_theme="Yaru"
    color_scheme="prefer-light"
    prefer_dark="false"
else
    gtk_theme="Yaru-dark"
    color_scheme="prefer-dark"
    prefer_dark="true"
fi
icon_theme="Yaru"

echo "Setting GTK to $mode mode..."

if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme"
    gsettings set org.gnome.desktop.interface color-scheme "$color_scheme"
    gsettings set org.gnome.desktop.interface icon-theme "$icon_theme"
fi

cat > "$gtk3_config_dir/settings.ini" << EOF
[Settings]
gtk-theme-name = $gtk_theme
gtk-icon-theme-name = $icon_theme
gtk-application-prefer-dark-theme = $prefer_dark
EOF

cat > "$gtk4_config_dir/settings.ini" << EOF
[Settings]
gtk-theme-name = $gtk_theme
gtk-icon-theme-name = $icon_theme
gtk-application-prefer-dark-theme = $prefer_dark
gtk-interface-color-scheme = $mode
EOF

echo "✓ GTK theme set to $mode mode ($gtk_theme)"
