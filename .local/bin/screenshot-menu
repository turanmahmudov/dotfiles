#!/bin/sh

## Screenshot menu for vicinae
## Uses hyprshot for taking screenshots

# Screenshot options
option_1="󰹑    Capture Desktop"
option_2="󰩭    Capture Area"
option_3="󰖲    Capture Window"
option_4="󰔛    Capture in 10s"

# Show menu and get selection
chosen=$(printf "%s\n%s\n%s\n%s" "$option_1" "$option_2" "$option_3" "$option_4" | vicinae dmenu --placeholder "Screenshot" --navigation-title "Screenshot" --no-section)

# Exit if no selection was made
if [ -z "$chosen" ]; then
	exit 0
fi

# Screenshot settings
time=$(date +%Y-%m-%d-%H-%M-%S)
dir=$(xdg-user-dir PICTURES)
file="Screenshot_${time}.png"

# Ensure screenshots directory exists
if [ ! -d "$dir" ]; then
	mkdir -p "$dir"
fi

# Execute screenshot based on selection
case "$chosen" in
	"$option_1")
		# Capture full desktop
		cd "$dir" && ~/.local/bin/hyprshot -m output -f "$file"
		;;
	"$option_2")
		# Capture selected area
		cd "$dir" && ~/.local/bin/hyprshot -m region -f "$file"
		;;
	"$option_3")
		# Capture active window
		cd "$dir" && ~/.local/bin/hyprshot -m window -f "$file"
		;;
	"$option_4")
		# Capture with 10 second delay
		sleep 10
		cd "$dir" && ~/.local/bin/hyprshot -m active -f "$file"
		;;
esac
