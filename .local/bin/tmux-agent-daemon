#!/bin/sh
# Keep the agent state of every pane in tmux options, so the status bar and the jump list can read it.
# Panes get @agent_state, @agent_name and a border color, windows get the worst state of their panes,
# and the server gets a @agent_summary count.
set -eu

bin=$(dirname "$0")

read_option() {
    value=$(tmux show -gqv "$1")
    [ -n "$value" ] || value=$2
    printf '%s\n' "$value"
}

interval=$(read_option @agent-interval 1)
color_blocked=$(read_option @agent-color-blocked colour3)
color_working=$(read_option @agent-color-working colour2)
color_done=$(read_option @agent-color-done colour4)
color_idle=$(read_option @agent-color-idle colour8)

run=${XDG_RUNTIME_DIR:-/tmp}
batch=$run/tmux-agent-batch.$$
cache=$run/tmux-agent-cache.$$
tab=$(printf '\t')

trap 'rm -f "$batch" "$cache"' EXIT

# A second daemon takes over the pid option, so the older one stops on its next turn.
tmux set -g @agent_daemon_pid "$$"
: >"$cache"

# A hook report answers "what happened while I was away", so a look at the window drops it.
# For a pane you can see, the screen is the better source, and a report that no later hook
# corrects (an answered prompt, for example) cannot stay behind.
clear_hook_reports() {
    seen=$(tmux list-panes -a -F '#{pane_id}' \
        -f '#{&&:#{@agent_hook},#{&&:#{window_active},#{session_attached}}}' 2>/dev/null || true)
    for id in $seen; do
        tmux set -p -t "$id" -u @agent_hook 2>/dev/null || true
    done
}

notify_blocked() {
    if [ "$(tmux show -gqv @agent-notify)" = "off" ]; then
        return 0
    fi
    command -v notify-send >/dev/null 2>&1 || return 0

    visible=$(tmux list-panes -a -F '#{pane_id}' \
        -f '#{&&:#{pane_active},#{&&:#{window_active},#{session_attached}}}' 2>/dev/null || true)

    printf '%s\n' "$1" | while IFS="$tab" read -r id state agent session window pane window_name; do
        [ "$state" = blocked ] || continue
        if grep -qx "$id${tab}blocked" "$cache"; then
            continue
        fi
        if printf '%s\n' "$visible" | grep -qx "$id"; then
            continue
        fi
        notify-send -a tmux -u normal "$agent needs an answer" "$session:$window.$pane $window_name"
    done
}

previous=
while [ "$(tmux show -gqv @agent_daemon_pid 2>/dev/null || true)" = "$$" ]; do
    clear_hook_reports
    scan=$("$bin/tmux-agent-scan" 2>/dev/null || true)
    if [ "$scan" = "$previous" ]; then
        sleep "$interval"
        continue
    fi
    previous=$scan

    {
        printf '%s\n' "$scan" | awk -F'\t' \
            -v blocked="$color_blocked" -v working="$color_working" \
            -v done_color="$color_done" -v idle="$color_idle" '
            BEGIN { color["blocked"] = blocked; color["working"] = working; color["done"] = done_color; color["idle"] = idle }
            NF > 1 {
                printf "set -p -t %s @agent_state %s\n", $1, $2
                printf "set -p -t %s @agent_name %s\n", $1, $3
                printf "set -p -t %s pane-border-style fg=%s\n", $1, color[$2]
            }'

        printf '%s\n' "$scan" | awk -F'\t' '
            BEGIN { rank["idle"] = 1; rank["done"] = 2; rank["working"] = 3; rank["blocked"] = 4 }
            NF > 1 {
                key = $4 ":" $5
                if (rank[$2] > best[key]) { best[key] = rank[$2]; state[key] = $2 }
            }
            END { for (key in state) printf "set -w -t %s @agent_state %s\n", key, state[key] }'

        # Panes and windows that lost their agent keep a stale mark unless it is removed.
        # A pane without its own @agent_name inherits the window value, so that option is the exact filter.
        marked_panes=$(tmux list-panes -a -F '#{pane_id}' -f '#{@agent_name}' 2>/dev/null || true)
        marked_windows=$(tmux list-windows -a -F '#{session_name}:#{window_index}' -f '#{@agent_state}' 2>/dev/null || true)
        printf '%s\n%s\n' "$marked_panes" "$marked_windows" | awk -F'\t' -v scan="$scan" '
            BEGIN {
                split(scan, lines, "\n")
                for (i in lines) {
                    split(lines[i], field, "\t")
                    if (field[1] != "") { live[field[1]] = 1; live[field[4] ":" field[5]] = 1 }
                }
            }
            $1 != "" && !($1 in live) {
                if (substr($1, 1, 1) == "%") {
                    printf "set -p -t %s -u @agent_name\n", $1
                    printf "set -p -t %s -u @agent_hook\n", $1
                    printf "set -p -t %s -u pane-border-style\n", $1
                }
                printf "set -%s -t %s -u @agent_state\n", (substr($1, 1, 1) == "%" ? "p" : "w"), $1
            }'

        printf '%s\n' "$scan" | awk -F'\t' \
            -v blocked="$color_blocked" -v working="$color_working" \
            -v done_color="$color_done" -v idle="$color_idle" '
            NF > 1 { count[$2]++ }
            END {
                summary = ""
                if (count["blocked"]) summary = summary sprintf("#[fg=%s,bold]● %d ", blocked, count["blocked"])
                if (count["working"]) summary = summary sprintf("#[fg=%s,nobold]◐ %d ", working, count["working"])
                if (count["done"]) summary = summary sprintf("#[fg=%s,bold]✓ %d ", done_color, count["done"])
                if (count["idle"]) summary = summary sprintf("#[fg=%s,nobold]○ %d ", idle, count["idle"])
                if (summary != "") summary = summary "#[nobold]"
                printf "set -g @agent_summary \"%s\"\n", summary
            }'
    } >"$batch"

    tmux source-file "$batch" 2>/dev/null || true
    notify_blocked "$scan"
    printf '%s\n' "$scan" | cut -f1,2 >"$cache"
    tmux refresh-client -S 2>/dev/null || true

    sleep "$interval"
done
