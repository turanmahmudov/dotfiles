#!/bin/sh
# The state of the coding agents that run on this machine.
#
#   agent report <name> working|blocked|done|gone [learn]   an agent reports itself
#   agent focus <key> [client]                              go to that agent
#   agent jump                                              pick one from a list
#   agent list [session]                                    print the live agents
#   agent send [key]                                        type stdin into that agent
#
# The agents are the only producers of the state: the Claude Code plugin and the opencode
# plugin call report. The bar and tmux only show what they wrote.
#
# One line per agent: key, agent, state, pid, pane, title, window, place, since.
# Since is the time of the report, which is how the panel tells a live state from a stuck one.
# The key is the tmux pane when the agent runs in tmux, otherwise its process id.
# The window is the hyprland address of the terminal, which is how an agent outside tmux
# is found again. It is read from the focused window, but only when the agent reports a
# submitted prompt (learn) or when nothing is recorded yet. Any other report can arrive
# while the user looks at another window, which would record the wrong one.
# No field may be empty, because the shell folds repeated tabs into one separator on read.
set -eu

file=${XDG_RUNTIME_DIR:-/tmp}/agents.tsv
tab=$(printf '\t')

read_field() {
    awk -F'\t' -v want="$1" -v column="$2" '$1 == want { print $column }' "$file" 2>/dev/null || true
}

# A session that the background daemon hosts runs on a pty of its own, with no terminal
# and no pane, so it can never be gone to. It is left out instead of listed as a row
# that answers nothing.
is_background() {
    walk=${1:-0}
    level=0
    while [ "$level" -lt 8 ] && [ "$walk" -gt 1 ]; do
        case $(tr '\0' ' ' <"/proc/$walk/cmdline" 2>/dev/null) in
        *bg-pty-host* | *"daemon run"*) return 0 ;;
        esac
        walk=$(ps -o ppid= -p "$walk" 2>/dev/null | tr -d ' ')
        [ -n "$walk" ] || break
        level=$((level + 1))
    done
    return 1
}

# The first agent process above the caller. The hook runs under a short lived shell, and
# this id stays the same across reports, which is how a dead agent is recognised later.
resolve_pid() {
    resolved=$PPID
    walk=$PPID
    level=0
    while [ "$level" -lt 6 ] && [ "$walk" -gt 1 ]; do
        if [ "$(ps -o comm= -p "$walk" 2>/dev/null || true)" = "$1" ]; then
            resolved=$walk
            break
        fi
        walk=$(ps -o ppid= -p "$walk" 2>/dev/null | tr -d ' ' || true)
        [ -n "$walk" ] || break
        level=$((level + 1))
    done
    printf '%s\n' "$resolved"
}

report() {
    agent=${1:-}
    state=${2:-}
    learn=${3:-}
    [ -n "$agent" ] && [ -n "$state" ] || exit 0

    pane=${TMUX_PANE:-}
    pid=$(resolve_pid "$agent")
    is_background "$pid" && exit 0
    key=${pane:-pid:$pid}
    title=${PWD##*/}

    place="-"
    if [ -n "$pane" ] && command -v tmux >/dev/null 2>&1; then
        place=$(tmux display -p -t "$pane" '#{session_name}:#{window_index}' 2>/dev/null || true)
        [ -n "$place" ] || place="-"
    fi

    window=$(read_field "$key" 7)
    [ -n "$window" ] || window="-"
    if { [ "$window" = "-" ] || [ "$learn" = learn ]; } &&
        command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
        found=$(hyprctl -j activewindow 2>/dev/null |
            jq -r --arg pid "${KITTY_PID:-0}" \
                'select((.pid | tostring) == $pid) | .address // empty' 2>/dev/null || true)
        if [ -n "$found" ]; then
            window=$found
        fi
    fi

    {
        keep_live "$key"
        if [ "$state" != gone ]; then
            printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                "$key" "$agent" "$state" "$pid" "${pane:--}" "${title:--}" "$window" "$place" \
                "$(date +%s)"
        fi
    } >"$file.$$"
    mv -f "$file.$$" "$file"

    # tmux only shows the report. The pane and its window carry the mark.
    [ -n "$pane" ] && command -v tmux >/dev/null 2>&1 || return 0
    if [ "$state" = gone ]; then
        tmux set -p -t "$pane" -u @agent_state 2>/dev/null || true
        tmux set -p -t "$pane" -u @agent_name 2>/dev/null || true
    else
        tmux set -p -t "$pane" @agent_state "$state" 2>/dev/null || true
        tmux set -p -t "$pane" @agent_name "$agent" 2>/dev/null || true
    fi
    sync_window "$pane"
    tmux refresh-client -S 2>/dev/null || true
}

# A window can hold more than one agent, and the mark has to speak for all of them,
# so it takes the state that asks for the most attention.
sync_window() {
    worst=$(tmux list-panes -t "$1" -F '#{@agent_state}' -f '#{@agent_name}' 2>/dev/null |
        awk '
            BEGIN { rank["done"] = 1; rank["working"] = 2; rank["blocked"] = 3 }
            rank[$1] > best { best = rank[$1]; state = $1 }
            END { print state }')
    if [ -n "$worst" ]; then
        tmux set -w -t "$1" @agent_state "$worst" 2>/dev/null || true
    else
        tmux set -w -t "$1" -u @agent_state 2>/dev/null || true
    fi
}

# Every agent that still has a process, except the one named by the argument.
# The read names carry a prefix because a function shares the caller's variables here.
keep_live() {
    [ -f "$file" ] || return 0
    while IFS="$tab" read -r old_key old_agent old_state old_pid old_pane old_title old_window old_place old_since; do
        [ -n "$old_key" ] || continue
        [ "$old_key" != "${1:-}" ] || continue
        kill -0 "$old_pid" 2>/dev/null || continue
        is_background "$old_pid" && continue
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$old_key" "$old_agent" "$old_state" "$old_pid" "$old_pane" "$old_title" \
            "$old_window" "${old_place:--}" "${old_since:-0}"
    done <"$file"
}

# An agent in a pane can be reached, one outside tmux often cannot, and two of them can
# carry the same title because the title is only the directory name. The reachable one
# comes first, so a typed word picks the row that can actually be gone to.
sort_by_reach() {
    rows=$(cat)
    printf '%s\n' "$rows" | awk -F'\t' '$5 != "-"'
    printf '%s\n' "$rows" | awk -F'\t' '$5 == "-"'
}

# An agent reports itself only once it does something, so one that was started and left
# alone is in no row yet. The panes say which agents exist, and a pane that reported
# nothing is added as done, which is the state that asks for no attention.
merge_panes() {
    reported=$(cat)
    printf '%s\n' "$reported"
    command -v tmux >/dev/null 2>&1 || return 0
    tmux list-panes -a -F "#{pane_id}${tab}#{pane_current_command}${tab}#{pane_current_path}${tab}#{session_name}:#{window_index}${tab}#{pane_pid}" 2>/dev/null |
        while IFS="$tab" read -r pane program path place pane_pid; do
            case $program in
            claude | codex | opencode) ;;
            *) continue ;;
            esac
            printf '%s\n' "$reported" | cut -f1 | grep -qx "$pane" && continue
            printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                "$pane" "$program" done "$pane_pid" "$pane" "${path##*/}" - "$place" "$(date +%s)"
        done
}

# An agent that is killed cannot report its own end, and the last one to die leaves nobody
# behind to clean up after it. The shell calls this, and it rewrites only when a row went.
list() {
    [ -f "$file" ] || exit 0
    live=$(keep_live "")
    if [ "$live" != "$(cat "$file")" ]; then
        if [ -n "$live" ]; then
            printf '%s\n' "$live" >"$file.$$"
        else
            : >"$file.$$"
        fi
        mv -f "$file.$$" "$file"
    fi
    live=$(printf '%s\n' "$live" | merge_panes | sort_by_reach)
    [ -n "$live" ] || exit 0
    # A session name keeps the agents of that session, which also drops the agents that run
    # outside tmux, because their place is empty.
    if [ -n "${1:-}" ]; then
        live=$(printf '%s\n' "$live" |
            awk -F'\t' -v session="$1" 'substr($8, 1, index($8, ":") - 1) == session')
        [ -n "$live" ] || exit 0
    fi
    printf '%s\n' "$live"
}

focus() {
    key=${1:-}
    want_client=${2:-}
    [ -n "$key" ] || exit 0

    pane=$(read_field "$key" 5)
    window=$(read_field "$key" 7)

    # An agent found in a pane is in no row, because only a report writes one. Its key is
    # the pane, so tmux can still name the target.
    if [ "${pane:--}" = "-" ] && command -v tmux >/dev/null 2>&1 &&
        tmux display -p -t "$key" '#{pane_id}' >/dev/null 2>&1; then
        pane=$key
    fi

    # Going to the agent answers the question the waiting mark asks, so the mark drops here.
    # It also frees a mark left behind by an agent that stopped reporting.
    if [ -f "$file" ]; then
        awk -F'\t' -v OFS='\t' -v want="$key" \
            '$1 == want && $3 == "blocked" { $3 = "done" } { print }' "$file" >"$file.$$" &&
            mv -f "$file.$$" "$file"
    fi

    if [ "${pane:--}" != "-" ] && command -v tmux >/dev/null 2>&1; then
        if [ "$(tmux show -p -t "$pane" -qv @agent_state 2>/dev/null || true)" = blocked ]; then
            tmux set -p -t "$pane" @agent_state "done" 2>/dev/null || true
            sync_window "$pane"
            tmux refresh-client -S 2>/dev/null || true
        fi

        session=$(tmux display -p -t "$pane" '#{session_name}' 2>/dev/null || true)
        if [ -n "$session" ]; then
            # The caller knows which screen asked, and with a phone attached the client on
            # that session can be the phone, so a named client wins over the search.
            client=$want_client
            if [ -z "$client" ]; then
                client=$(tmux list-clients -F "#{client_name}${tab}#{client_session}" 2>/dev/null |
                    awk -F'\t' -v want="$session" '$2 == want { print $1; exit }')
            fi
            [ -n "$client" ] || client=$(tmux list-clients -F '#{client_name}' 2>/dev/null | head -1)
            if [ -n "$client" ]; then
                tmux switch-client -c "$client" -t "$session" 2>/dev/null || true
                tmux select-window -c "$client" -t "$pane" 2>/dev/null || true
                tmux select-pane -t "$pane" 2>/dev/null || true
            fi
            # tmux writes the session name into the terminal title, which names the window here.
            if [ "${window:--}" = "-" ] && command -v hyprctl >/dev/null 2>&1 &&
                command -v jq >/dev/null 2>&1; then
                window=$(hyprctl -j clients 2>/dev/null |
                    jq -r --arg title "$session - tmux" \
                        'map(select(.title == $title)) | .[0].address // empty')
            fi
        fi
    fi

    [ "${window:--}" != "-" ] || exit 0
    command -v hyprctl >/dev/null 2>&1 || exit 0
    command -v jq >/dev/null 2>&1 || exit 0

    # A recorded window can be closed by now, and focusing a dead address logs an error.
    live=$(hyprctl -j clients 2>/dev/null |
        jq -r --arg address "$window" 'map(select(.address == $address)) | .[0].address // empty')
    [ -n "$live" ] || exit 0

    # Hyprland runs a lua config here, so a dispatch takes the lua form, not the plain one.
    hyprctl dispatch "hl.dsp.focus({ window = 'address:$live' })" >/dev/null 2>&1 || true
}

# The live agents in a menu. It prints the row of the chosen one, and the key comes first.
# The sort decides what a typed word selects. A jump keeps the report order. A send ranks by
# the match instead, because the name of one agent is a loose match of another, and without a
# rank the text reaches whichever of them the state file holds first.
pick() {
    rows=$(list "${1:-}" | awk -F'\t' '
        BEGIN {
            color["blocked"] = "\033[33m"; mark["blocked"] = "●"
            color["working"] = "\033[32m"; mark["working"] = "◐"
            color["done"] = "\033[34m"; mark["done"] = "✓"
        }
        { printf "%s\t%s%s %-7s\033[0m %-9s %s %s\n", $1, color[$3], mark[$3], $3, $2, $6, ($8 == "-" ? "" : $8) }')
    # An empty menu tells the caller nothing, so a caller that has a reason to report says it.
    [ -n "$rows" ] || return 1
    printf '%s\n' "$rows" |
        fzf --ansi --delimiter="$tab" --with-nth=2.. ${3-} --header="${2:-go to agent}" || true
}

# A popup is no client of its own, and tmux resolves the current client of a popup to
# whichever client it likes. TMUX names the session of the client that opened it, and
# that is the screen that asked, which matters as soon as a second client is attached.
resolve_client() {
    want=$(printf '%s' "${TMUX:-}" | awk -F, '{ print $3 }')
    [ -n "$want" ] || return 0
    tmux list-clients -F "#{client_name}${tab}#{session_id}" 2>/dev/null |
        awk -F'\t' -v want="\$$want" '$2 == want { print $1; exit }'
}

jump() {
    selected=$(pick "" "go to agent" --no-sort) || exit 0
    [ -n "$selected" ] || exit 0
    focus "${selected%%"$tab"*}" "$(resolve_client)"
}

# Text that the user wrote elsewhere, typed into the prompt of a running agent.
# The agent reads a terminal, so the pane pastes the text and then submits it.
send() {
    note=$(mktemp)
    trap 'rm -f "$note"' EXIT HUP INT TERM
    cat >"$note"
    [ -s "$note" ] || { echo "nothing to send" >&2; exit 1; }

    command -v tmux >/dev/null 2>&1 || { echo "tmux is not running" >&2; exit 1; }

    key=${1:-}
    if [ -z "$key" ]; then
        # The session holds the work the text is about, so the menu stops at its own agents.
        session=$(tmux display -p '#{session_name}' 2>/dev/null || true)
        [ -n "$session" ] || { echo "no tmux session to send from" >&2; exit 1; }
        selected=$(pick "$session" "send to an agent of $session") ||
            { echo "no agent of $session reported itself" >&2; exit 1; }
        [ -n "$selected" ] || exit 0
        key=${selected%%"$tab"*}
    fi

    pane=$(read_field "$key" 5)
    # An agent reports itself only after its first prompt, and a fresh one is in no row yet.
    # Its key is the pane, so tmux can still name the target.
    if [ "${pane:--}" = "-" ] && tmux display -p -t "$key" '#{pane_id}' >/dev/null 2>&1; then
        pane=$key
    fi
    [ "${pane:--}" != "-" ] || { echo "agent $key does not run in a tmux pane" >&2; exit 1; }

    # The text belongs to the repository it was written in. An agent of another repository
    # cannot act on it, so the send stops here instead of asking for a change to files that
    # the agent does not have. Two worktrees of one repository count as two repositories.
    note_repo=$(git rev-parse --show-toplevel 2>/dev/null || true)
    agent_path=$(tmux display -p -t "$pane" '#{pane_current_path}' 2>/dev/null || true)
    agent_repo=""
    if [ -n "$agent_path" ]; then
        agent_repo=$(git -C "$agent_path" rev-parse --show-toplevel 2>/dev/null || true)
    fi
    if [ -n "$note_repo" ] && [ -n "$agent_repo" ] && [ "$note_repo" != "$agent_repo" ]; then
        echo "the text is from $note_repo" >&2
        echo "this agent works in $agent_repo" >&2
        exit 1
    fi

    tmux load-buffer -b agent-send "$note"
    # Bracketed paste keeps a multiple line note as one prompt instead of many submits.
    tmux paste-buffer -d -b agent-send -p -t "$pane"
    tmux send-keys -t "$pane" Enter
}

command=${1:-}
[ "$#" -eq 0 ] || shift
case $command in
report) report "$@" ;;
focus) focus "$@" ;;
jump) jump ;;
list) list "$@" ;;
send) send "$@" ;;
*)
    echo "usage: ${0##*/} report <name> <state> [learn] | focus <key> [client] | list [session] | jump | send [key]" >&2
    exit 1
    ;;
esac
