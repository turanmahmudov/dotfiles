#!/usr/bin/env python3
"""Print the events of the selected Evolution Data Server calendars as JSON.

Usage: calendar-events FIRST_DAY LAST_DAY   (dates as YYYY-MM-DD, both inclusive)
"""
import concurrent.futures
import datetime
import json
import sys

import gi

gi.require_version("ECal", "2.0")
gi.require_version("EDataServer", "1.2")
gi.require_version("ICalGLib", "3.0")
from gi.repository import ECal, EDataServer  # noqa: E402


def parse_day(text):
    return datetime.date.fromisoformat(text)


def to_local(ical_time):
    if ical_time.is_date():
        return datetime.datetime(ical_time.get_year(), ical_time.get_month(), ical_time.get_day())
    epoch = ical_time.as_timet_with_zone(ical_time.get_timezone())
    return datetime.datetime.fromtimestamp(epoch)


def list_days(start, end, first_day, last_day):
    last = end - datetime.timedelta(seconds=1) if end > start else start
    day = max(start.date(), first_day)
    days = []
    while day <= min(last.date(), last_day):
        days.append(day.isoformat())
        day += datetime.timedelta(days=1)
    return days


def connect_client(source):
    try:
        return source, ECal.Client.connect_sync(source, ECal.ClientSourceType.EVENTS, 1, None)
    except Exception as error:
        print(f"calendar-events: {source.get_display_name()}: {error}", file=sys.stderr)
        return source, None


def collect_events(first_day, last_day):
    window_start = int(datetime.datetime.combine(first_day, datetime.time()).timestamp())
    window_end = int(datetime.datetime.combine(last_day + datetime.timedelta(days=1), datetime.time()).timestamp())
    registry = EDataServer.SourceRegistry.new_sync(None)
    sources = [
        source for source in registry.list_enabled(EDataServer.SOURCE_EXTENSION_CALENDAR)
        if source.get_extension(EDataServer.SOURCE_EXTENSION_CALENDAR).get_selected()
    ]
    # connect_sync waits the full timeout for a remote backend.
    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, len(sources))) as pool:
        clients = list(pool.map(connect_client, sources))
    events = []
    for source, client in clients:
        if client is None:
            continue
        extension = source.get_extension(EDataServer.SOURCE_EXTENSION_CALENDAR)

        def add_instance(component, instance_start, instance_end, *_):
            all_day = instance_start.is_date()
            start = to_local(instance_start)
            end = to_local(instance_end) if instance_end and not instance_end.is_null_time() else start
            days = list_days(start, end, first_day, last_day)
            if days:
                events.append({
                    "title": component.get_summary() or "(no title)",
                    "location": component.get_location() or "",
                    "calendar": source.get_display_name(),
                    "color": extension.get_color() or "",
                    "allDay": all_day,
                    "start": start.strftime("%H:%M") if not all_day else "",
                    "end": end.strftime("%H:%M") if not all_day else "",
                    "sortKey": start.isoformat(),
                    "days": days,
                })
            return True

        try:
            client.generate_instances_sync(window_start, window_end, None, add_instance)
        except Exception as error:
            print(f"calendar-events: {source.get_display_name()}: {error}", file=sys.stderr)
    events.sort(key=lambda event: (not event["allDay"], event["sortKey"]))
    return events


def main():
    if len(sys.argv) != 3:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    print(json.dumps(collect_events(parse_day(sys.argv[1]), parse_day(sys.argv[2]))))
    return 0


if __name__ == "__main__":
    sys.exit(main())
