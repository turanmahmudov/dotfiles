#!/bin/sh
# Report the state of every tmux pane that runs a coding agent.
# One TSV line per agent pane: pane id, state, agent, session, window index, pane index, window name.
# The state is working, blocked, done or idle. The screen tells working and blocked.
# An agent hook writes @agent_hook, which adds the prompts the screen patterns miss and
# reports done, because a finished turn looks the same as an idle one on the screen.
# A hook that says working is not trusted over the screen, so a missed end of turn cannot stick.
set -eu

AGENTS='claude|codex|opencode|cursor-agent|gemini|aider|crush|goose|droid|amp|copilot|qwen|kimi'

# Only the bottom of the visible screen counts. An approval prompt wins over a busy spinner.
# An agent draws its approval UI at the start of a line, but writes the same words mid sentence
# in its answers ("what do you want to work on?"), so the anchor keeps the two apart.
BLOCKED_PROMPT_RE='^[[:space:]│▌]*((❯|›|▸|>)[[:space:]]*1\.[[:space:]]*(yes|allow|approve)|do you want to .*\?|allow (this |the )?(command|tool|edit|access)|press enter to continue|waiting for (your )?(approval|input))'
BLOCKED_ANSWER_RE='\((y/n|n/y)\)|\[(y/n|y/N|Y/n)\]'
# A spinner line looks like "✽ Thinking… (12s · 2.3k tokens)". The elapsed timer is the strongest sign.
WORKING_RE='(…|\.\.\.)[[:space:]]*\([0-9]+(s|m|h)|esc(ape)? to (interrupt|cancel|stop)|ctrl[+-]c to (interrupt|cancel|stop)|(thinking|working|running|generating|processing|compacting)(\.\.\.|…)'

SCREEN_LINES=15

tab=$(printf '\t')
procs=$(ps -eo pid=,ppid=,comm=,args=)

# Name of the first agent in the process tree below the pane shell. An agent started through
# an interpreter or a wrapper keeps its own name only in the command line, so both are read.
resolve_agent() {
    printf '%s\n' "$procs" | awk -v root="$1" -v agents="$AGENTS" '
        BEGIN { total = split(agents, agent, "|") }
        {
            child[$2] = child[$2] " " $1
            name[$1] = $3
            args[$1] = substr($0, index($0, $4))
        }
        END {
            queue[0] = root
            count = 1
            for (i = 0; i < count; i++) {
                pid = queue[i]
                for (a = 1; a <= total; a++) {
                    if (name[pid] == agent[a]) { print agent[a]; exit }
                    if (args[pid] ~ ("(^|/)" agent[a] "([.][a-z]+)?( |$)")) { print agent[a]; exit }
                }
                found = split(child[pid], kids, " ")
                for (k = 1; k <= found; k++) queue[count++] = kids[k]
            }
        }'
}

# Every field must stay non-empty. The shell folds repeated tabs into one separator,
# so an empty field would shift every field after it.
format="#{pane_id}${tab}#{pane_pid}${tab}#{session_name}${tab}#{window_index}${tab}#{pane_index}${tab}#{?@agent_hook,#{@agent_hook},-}${tab}#{window_name}"

tmux list-panes -a -F "$format" | while IFS="$tab" read -r id pid session window pane hook window_name; do
    agent=$(resolve_agent "$pid")
    [ -n "$agent" ] || continue

    screen=$(tmux capture-pane -p -t "$id" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -n "$SCREEN_LINES" || true)
    if printf '%s\n' "$screen" | grep -Eqi "$BLOCKED_PROMPT_RE|$BLOCKED_ANSWER_RE"; then
        state=blocked
    elif [ "$hook" = blocked ]; then
        state=blocked
    elif printf '%s\n' "$screen" | grep -Eqi "$WORKING_RE"; then
        state=working
    elif [ "$hook" = "done" ]; then
        state="done"
    else
        state=idle
    fi

    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$state" "$agent" "$session" "$window" "$pane" "$window_name"
done
